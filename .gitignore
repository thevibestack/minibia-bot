node_modules/

# Generated by tools/extract-catalog.js (page-context run) — never committed
catalog.json

# The DESKTOP APP bundles catalog.json + npcTrades.json as build inputs
# (REQ-07: binary must resolve lookups offline). Unlike the userscript's
# runtime side-load, these ARE committed — they are required build assets.
!/app/assets/catalog.json
!/app/assets/npcTrades.json
dist/
